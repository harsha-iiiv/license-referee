# Sanity project that holds the structured license data (schema in ./studio)
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Project token with Editor + Deploy Studio permissions. Used only by scripts (import, schema deploy).
SANITY_AUTH_TOKEN=

# Sanity Context (organization level). Create in Manage > API > Tokens with "Context Viewer".
SANITY_ORGANIZATION_ID=
SANITY_ORGANIZATION_TOKEN=
# Knowledge Base mode endpoint (required by the challenge)
SANITY_CONTEXT_MCP_URL=
# GROQ mode endpoint over the same dataset (deterministic compatibility lookups)
SANITY_CONTEXT_GROQ_MCP_URL=

# LLM
GOOGLE_GENERATIVE_AI_API_KEY=
